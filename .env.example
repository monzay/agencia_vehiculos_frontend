# ════════════════════════════════════════════════════════════════════════════
#  WEB (Next.js) — variables de entorno de PRODUCCIÓN
# ════════════════════════════════════════════════════════════════════════════
# En Vercel se cargan en Settings → Environment Variables (este archivo es solo
# la lista). NUNCA poner valores reales acá.
#
# Ojo: las NEXT_PUBLIC_ quedan a la vista de cualquiera en el navegador.
# Nunca poner una clave o un token en una NEXT_PUBLIC_.
#
# En desarrollo, .env.development (número de prueba) y .env.production
# (producción) ya traen los valores públicos; .env.local, los tokens.
# Explicación completa: bóveda → "Variables de entorno".

# ── 1. Conexiones ───────────────────────────────────────────────────────────
# [obligatoria] Dirección de la API (backend). Sin esto la web no muestra autos
# y el panel no anda.
NEXT_PUBLIC_API_URL="https://api.tudominio.com"
# [recomendada] Dominio público de la web: con él se arma el link de captación
# de cada asesor (dominio/a/<asesor>). Si falta, usa la dirección donde está
# abierto el panel.
NEXT_PUBLIC_SITE_URL="https://www.seaautomotores.com"

# ── 2. WhatsApp ─────────────────────────────────────────────────────────────
# [opcional] Número del bot al que abre el botón "Consultar" (solo dígitos, con
# código de país). Si falta, usa el de producción que está en lib/constantes.js.
NEXT_PUBLIC_WHATSAPP_BOT="5493885129241"

# ── 3. Imágenes (Vercel Blob) — privadas, sin NEXT_PUBLIC_ ──────────────────
# [obligatoria] Store PÚBLICO del catálogo: subir fotos de los autos desde el panel.
BLOB_READ_WRITE_TOKEN=""
# [opcional] Store PRIVADO de documentos de consignación (DNI, títulos). El mismo
# valor que BLOB_DOCUMENTOS_TOKEN del backend.
BLOB_DOCUMENTOS_TOKEN=""
